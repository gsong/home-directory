{
  "title": "Siri",
  "rules": [
    {
      "description": "Press the right command key twice to open Siri",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "right_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "right_command" }],
          "to_if_alone": [
            {
              "shell_command": "/usr/bin/open -a /System/Applications/Siri.app"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "right_command_tapped",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "right_command" }],
          "to_if_alone": [
            {
              "set_variable": { "name": "right_command_tapped", "value": 1 }
            }
          ],
          "to_delayed_action": {
            "to_if_invoked": [
              {
                "set_variable": { "name": "right_command_tapped", "value": 0 }
              }
            ],
            "to_if_canceled": [
              {
                "set_variable": { "name": "right_command_tapped", "value": 0 }
              }
            ]
          }
        }
      ]
    }
  ]
}
