{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "EDITOR": "nvim",
    "ENABLE_TOOL_SEARCH": "auto:0"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(brew *)",
      "Bash(cp *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(jq *)",
      "Bash(mise *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(pnpm *)",
      "Bash(rg *)",
      "Bash(test *)",
      "WebFetch(domain:anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:githubusercontent.com)",
      "WebFetch(domain:mise.jdx.dev)",
      "WebSearch",
      "mcp__claude_ai_Linear",
      "mcp__context7"
    ],
    "deny": [
      "Read(~/.aws/credentials)",
      "Read(~/.config/gcloud/access_tokens.db)",
      "Read(~/.config/gcloud/application_default_credentials.json)",
      "Read(~/.config/gcloud/credentials.db)",
      "Read(~/.ssh/id_*)",
      "Read(~/.terraform.d/credentials.tfrc.json)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "gws-sheets": "off",
    "gws-slides": "off",
    "vercel-react-best-practices": "off",
    "web-design-guidelines": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bash-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-notify.mjs"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ask-via-tool.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-notify.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "codex-tools@gsong-marketplace": true,
    "git-tools@gsong-marketplace": true,
    "gh-tools@gsong-marketplace": true,
    "utilities@gsong-marketplace": true,
    "security-guidance@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "writing@gsong-marketplace": true,
    "browser@gsong-marketplace": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "gsong-marketplace": {
      "source": {
        "source": "github",
        "repo": "gsong/claude-marketplace"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Plain Technical",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "preferredNotifChannel": "ghostty",
  "fileCheckpointingEnabled": true,
  "todoFeatureEnabled": false,
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
