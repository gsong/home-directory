{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "EDITOR": "nvim",
    "ENABLE_TOOL_SEARCH": "auto:0"
  },
  "includeCoAuthoredBy": false,
  "outputStyle": "Plain Technical",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(/bin/ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(jq:*)",
      "Bash(ast-grep:*)",
      "Bash(mise:*)",
      "Bash(brew:*)",
      "Bash(pnpm:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(test:*)",
      "Bash(cd:*)",
      "Bash(echo:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:githubusercontent.com)",
      "WebFetch(domain:anthropic.com)",
      "WebFetch(domain:mise.jdx.dev)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bash-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-notify.mjs"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ask-via-tool.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-notify.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path' /dev/stdin); prettier --write --ignore-unknown \"$(realpath \"$file\")\""
          },
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path' /dev/stdin); if [[ \"$file\" == *.sql ]]; then sqlfluff fix \"$(realpath \"$file\")\"; fi"
          },
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path' /dev/stdin); if [[ \"$file\" == *.py ]]; then ruff check --fix \"$(realpath \"$file\")\"; fi"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "ast-grep@ast-grep-marketplace": true,
    "feature-dev@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "codex-tools@gsong-marketplace": true,
    "git-tools@gsong-marketplace": true,
    "gh-tools@gsong-marketplace": true,
    "utilities@gsong-marketplace": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "costmine-marketplace": {
      "source": {
        "source": "github",
        "repo": "GlacierRIG/ai-plugins"
      },
      "autoUpdate": true
    },
    "gsong-marketplace": {
      "source": {
        "source": "directory",
        "path": "/Users/george/src/gsong/claude-marketplace"
      },
      "autoUpdate": true
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "preferredNotifChannel": "ghostty",
  "fileCheckpointingEnabled": true,
  "todoFeatureEnabled": false,
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754086408110
  }
}
