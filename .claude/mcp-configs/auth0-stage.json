{
  "mcpServers": {
    "auth0-stage": {
      "command": "${HOME}/.home-directory/bin/auth0-mcp-tenant",
      "env": {
        "AUTH0_DOMAIN": "costmine-stage.us.auth0.com",
        "AUTH0_CLIENT_ID": "${AUTH0_STAGE_CLIENT_ID}",
        "AUTH0_CLIENT_SECRET": "${AUTH0_STAGE_CLIENT_SECRET}"
      }
    }
  }
}
