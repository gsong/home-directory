# Taps
tap "buo/cask-upgrade", trusted: true

# Auth0
tap "auth0/auth0-cli", trusted: true
brew "auth0/auth0-cli/auth0"       # Auth0 command-line interface

# Ookla Speedtest
tap "teamookla/speedtest", trusted: true
brew "teamookla/speedtest/speedtest" # Official Ookla Speedtest CLI

# Core Utilities
brew "bash"                    # Modern Bash shell
brew "gnu-sed"                 # GNU sed (gsed)
brew "openssl"                 # Cryptography and SSL/TLS toolkit
brew "rsync"                   # Fast file copying tool
brew "tree"                    # Display directory structure
brew "wget"                    # Non-interactive network downloader

# Development Tools
brew "azure-cli"               # Azure CLI (az devops; Python pins break it under mise)
brew "gh"                      # GitHub CLI
brew "git"                     # Distributed version control
brew "git-delta"               # Syntax-highlighting pager for git/diff
brew "git-filter-repo"         # Fast, flexible tool for rewriting git history
brew "git-lfs"                 # Git Large File Storage
brew "libvips"                 # Image processing library (for Astro)
brew "libyaml"                 # YAML parser (for Ruby)

# Shell & Terminal Enhancements
brew "bash-completion@2"       # Bash completion scripts
brew "eza"                     # Modern ls replacement
brew "fd"                      # Modern find replacement
brew "fzf"                     # Command-line fuzzy finder
brew "m-cli"                   # macOS command-line tools
brew "mole"                    # Deep clean and optimize your Mac
brew "mise"                    # Polyglot runtime version manager
brew "pam-reattach"            # Touch ID support for tmux
brew "reattach-to-user-namespace" # macOS clipboard support for tmux
brew "ripgrep"                 # Modern grep replacement
brew "starship"                # Cross-shell prompt
brew "stow"                    # Symlink farm manager
brew "tmux"                    # Terminal multiplexer

# Editor Tools
brew "luarocks"                # Lua package manager (for Neovim)
brew "neovim"                  # Hyperextensible Vim-based text editor
cask "vimr"                    # Neovim GUI for macOS

# Miscellaneous CLI Tools
brew "b2-tools"                # Backblaze B2 cloud storage CLI
brew "cloc"                    # Count lines of code
brew "czkawka"                 # Find duplicates, empty folders, similar images
brew "jpegoptim"               # Lossless JPEG optimizer
brew "lastpass-cli"            # LastPass CLI (lpass)
brew "ollama"                  # Run LLMs locally

# Quick Look Plugins
cask "quicklook-video"         # Preview video thumbnails

# GUI Applications

# Productivity & Utilities
cask "1password", greedy: true
cask "1password-cli", greedy: true
cask "alfred", greedy: true    # Application launcher and productivity
cask "bartender"               # Menu bar icon organiser
cask "betterdisplay", greedy: true # Display management
cask "karabiner-elements"      # Keyboard remapping (double-tap right cmd for Spotlight)
cask "keyboardcleantool"       # Disable keyboard for cleaning
cask "libreoffice"             # Open-source office suite
cask "menuwhere"               # Access menu bar with hotkey
cask "moom"                    # Window management
cask "soundsource", greedy: true # Audio routing

# Web Browsers
cask "arc", greedy: true        # Innovative web browser
cask "crest-browser", greedy: true # Arc-like browser with Spaces
cask "google-chrome"           # Google Chrome browser

# Communication
cask "discord"
cask "microsoft-teams"
cask "slack", greedy: true
cask "whatsapp"
cask "zoom", greedy: true

# Microsoft
cask "microsoft-auto-update"   # Microsoft AutoUpdate

# Development Tools
cask "claude"                  # Anthropic Claude desktop
cask "docker-desktop", greedy: true
cask "ghostty", greedy: true   # GPU-accelerated terminal
cask "linear"                  # Linear.app
cask "ngrok"                   # Secure tunnels to localhost
cask "session-manager-plugin"  # AWS SSM sessions (aws ssm start-session)
cask "sourcetree", greedy: true # Git GUI

# File & System Management
cask "carbon-copy-cloner", greedy: true # Backup solution
cask "coconutbattery"          # Battery health
cask "cyberduck"               # FTP/SFTP browser
cask "daisydisk"               # Disk space analyzer
cask "dropbox", greedy: true
cask "google-drive"
cask "istat-menus", greedy: true # System statistics
cask "pearcleaner"             # Advanced app cleaner
cask "homebrew/cask/sloth"     # Display open files/sockets (bare "sloth" now resolves to the sloth-cli formula)

# Media & Notes
cask "fsnotes", greedy: true   # Markdown notes manager
cask "macwhisper", greedy: true # Local audio transcription
cask "marked-app", greedy: true # Markdown preview
cask "screenflow"              # Screen recording
cask "shottr"                  # Screenshot tool
cask "taskpaper"               # Plain text task management

# Fonts
cask "font-sauce-code-pro-nerd-font"

