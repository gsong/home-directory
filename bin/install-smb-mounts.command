#!/bin/bash
# Install the buffalo SMB auto-mount agent on this Mac.
#
# Prompts for a NAS account and the shares to mount, stores the password in the
# login keychain, then generates and activates a LaunchAgent that mounts those
# shares at login, on wake, and whenever the network changes. Nothing secret is
# written to disk.
#
#   ./install-smb-mounts.command              install or re-install
#   ./install-smb-mounts.command --uninstall  remove everything it created
#
# Must be run on the home network: the last step verifies a real mount.

set -uo pipefail

# The mDNS name, not the bare NetBIOS name. NetBIOS resolution is unreliable and
# reports its failures as a misleading "No route to host", which makes an
# otherwise healthy mount fail at random.
HOST=buffalo.local
ALT_HOST=buffalo # NetBIOS name; the keychain is seeded for both spellings

LABEL=local.mount-smb-shares
SUPPORT_DIR="$HOME/Library/Application Support/mount-smb-shares"
SCRIPT_PATH="$SUPPORT_DIR/mount-smb-shares"
PLIST_PATH="$HOME/Library/LaunchAgents/$LABEL.plist"

ACCOUNT=""
PASSWORD=""
AVAILABLE=""    # newline-separated share names the account can see
SHARES=(dummy)  # replaced by choose_shares; bash 3.2 dislikes empty arrays

main() {
	case "${1:-}" in
	--uninstall)
		uninstall
		exit $?
		;;
	"") ;;
	*)
		printf 'usage: %s [--uninstall]\n' "${0##*/}" >&2
		exit 2
		;;
	esac

	refuse_if_symlinked
	require_home_network
	prompt_for_working_credentials
	choose_shares
	write_mount_script
	write_plist
	activate_agent
	verify_mounts
}

# --- install steps ---------------------------------------------------------

# A symlinked plist means a dotfiles-managed machine (the author's own), where
# these files are owned by stow. Overwriting them would clobber that setup.
refuse_if_symlinked() {
	if [ -L "$PLIST_PATH" ]; then
		fail "$PLIST_PATH is a symlink, so this Mac already manages the agent
through dotfiles. Refusing to overwrite it."
	fi
}

require_home_network() {
	local ip
	ip=$(resolve_host)
	if [ -z "$ip" ]; then
		fail "Cannot find $HOST on this network.
Connect this laptop to the home Wi-Fi and run this again."
	fi
	printf 'Found %s at %s\n\n' "$HOST" "$ip"
}

# Seeds the keychain, then proves the credentials against the NAS. Re-prompts
# until they work, so a typo costs one retry instead of a failed install.
prompt_for_working_credentials() {
	while :; do
		ACCOUNT=""
		while [ -z "$ACCOUNT" ]; do
			read -r -p "NAS account name: " ACCOUNT
		done

		PASSWORD=""
		while [ -z "$PASSWORD" ]; do
			read -r -s -p "Password for $ACCOUNT: " PASSWORD
			printf '\n'
		done

		store_password "$HOST"
		store_password "$ALT_HOST"

		printf 'Checking those credentials against %s ...\n' "$HOST"
		# </dev/null so a rejected password can never leave us at a prompt.
		AVAILABLE=$(/usr/bin/smbutil view "//$ACCOUNT@$HOST" </dev/null 2>/dev/null |
			/usr/bin/awk '$2 == "Disk" { print $1 }')
		if [ -n "$AVAILABLE" ]; then
			printf 'Credentials accepted.\n\n'
			PASSWORD=""
			return
		fi

		printf '\nThat did not work: the server rejected the account or password,\n'
		printf 'or it has no shares. Try again.\n\n'
		forget_password "$HOST"
		forget_password "$ALT_HOST"
	done
}

choose_shares() {
	local count=0 name
	printf 'Shares %s can see:\n' "$ACCOUNT"
	while IFS= read -r name; do
		count=$((count + 1))
		printf '  %d) %s\n' "$count" "$name"
	done <<<"$AVAILABLE"

	printf '\nWhich should mount automatically?\n'
	printf 'Enter numbers separated by spaces, or "a" for all: '

	local reply
	read -r reply
	SHARES=()
	case "$reply" in
	a | A | all | ALL)
		while IFS= read -r name; do SHARES+=("$name"); done <<<"$AVAILABLE"
		;;
	*)
		local n
		for n in $reply; do
			name=$(printf '%s\n' "$AVAILABLE" | /usr/bin/sed -n "${n}p" 2>/dev/null)
			if [ -z "$name" ]; then
				printf '\n"%s" is not one of the listed numbers.\n\n' "$n"
				choose_shares
				return
			fi
			SHARES+=("$name")
		done
		;;
	esac

	if [ ${#SHARES[@]} -eq 0 ]; then
		printf '\nPick at least one share.\n\n'
		choose_shares
		return
	fi
	printf '\nWill auto-mount: %s\n\n' "${SHARES[*]}"
}

write_mount_script() {
	/bin/mkdir -p "$SUPPORT_DIR" || fail "Cannot create $SUPPORT_DIR"

	# The configuration is emitted as real assignments, then the logic follows as
	# a quoted heredoc so nothing in it needs escaping.
	{
		printf '#!/bin/bash\n'
		printf '# Generated by install-smb-mounts.command. Edit the installer, not this.\n'
		printf '# Mounts the SMB shares below whenever the NAS is on the current network.\n\n'
		printf 'set -uo pipefail\n\n'
		printf 'HOST=%q\n' "$HOST"
		printf 'ALT_HOST=%q\n' "$ALT_HOST"
		printf 'ACCOUNT=%q\n' "$ACCOUNT"
		printf 'SHARES=(%s)\n' "$(quoted_shares)"
		/bin/cat <<'BODY'

log() { /usr/bin/logger -t mount-smb-shares "mount-smb-shares: $*"; }

# Resolving is the reachability test: away from home the mDNS name does not
# resolve, so this exits quietly. ping is only being used as a resolver here: it
# prints the address before waiting for a reply, so this still works if the NAS
# ignores ICMP, and it returns the moment the name resolves (~15ms warm) instead
# of always waiting out the full mDNS timeout the way dscacheutil did.
#
# -t5 is a deadline covering resolution as well, so it has to be generous enough
# for a COLD lookup. -t1 was not: after a reboot there is no cached record, the
# query needs a full multicast round trip, and login-time load starves the
# process, so the first run after a restart failed and the shares stayed
# unmounted until the next retry. Do not shorten this.
ip=$(/sbin/ping -c1 -t5 "$HOST" 2>/dev/null |
  /usr/bin/awk -F'[()]' 'NR == 1 { print $2; exit }')
if [ -z "$ip" ]; then
  log "$HOST did not resolve; not on the home network"
  exit 0
fi

# Confirm SMB is accepting connections before trying to mount, because a failed
# `mount volume` puts a modal dialog on screen. Checking the resolved address
# keeps this instant.
if ! /usr/bin/nc -z -G 2 -w 2 "$ip" 445 >/dev/null 2>&1; then
  log "$HOST ($ip) is not accepting SMB connections"
  exit 0
fi

for share in "${SHARES[@]}"; do
  # Match on the mount source rather than the mountpoint so a share already
  # mounted somewhere is never mounted a second time as <share>-1.
  existing=$(/sbin/mount | /usr/bin/awk \
    -v a="//$ACCOUNT@$HOST/$share" -v b="//$ACCOUNT@$ALT_HOST/$share" \
    '$1 == a || $1 == b { print $3 }')
  if [ -n "$existing" ]; then
    [ "$existing" = "/Volumes/$share" ] ||
      log "$share already mounted at $existing, expected /Volumes/$share"
    continue
  fi

  # `mount volume` goes through NetFS exactly as Finder does: it creates and
  # later cleans up the /Volumes mountpoint itself, needs no root, and produces
  # a browsable mount that shows up in the Finder sidebar.
  if /usr/bin/osascript -e "mount volume \"smb://$ACCOUNT@$HOST/$share\"" >/dev/null 2>&1; then
    log "mounted $share"
  else
    log "failed to mount $share"
  fi
done
BODY
	} >"$SCRIPT_PATH" || fail "Cannot write $SCRIPT_PATH"

	/bin/chmod 755 "$SCRIPT_PATH"
	/bin/mkdir -p "$HOME/Library/LaunchAgents"
	printf 'Wrote %s\n' "$SCRIPT_PATH"
}

write_plist() {
	/bin/cat >"$PLIST_PATH" <<PLIST || fail "Cannot write $PLIST_PATH"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$LABEL</string>

	<key>ProgramArguments</key>
	<array>
		<string>$(xml_escape "$SCRIPT_PATH")</string>
	</array>

	<!-- Fires at login, which is also when the login keychain unlocks. -->
	<key>RunAtLoad</key>
	<true/>

	<!-- Polls every 5 minutes, which also covers waking up and arriving home.
	     Deliberately NOT LaunchEvents/com.apple.notifyd.matching: those events
	     are delivered over the XPC event stream and must be consumed with
	     xpc_set_event_stream_handler(), which a shell script cannot do. The
	     event is then never dequeued, so launchd relaunches the job every time
	     it exits, forever, at its ~10s minimum interval. -->
	<key>StartInterval</key>
	<integer>300</integer>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
PLIST

	/usr/bin/plutil -lint "$PLIST_PATH" >/dev/null ||
		fail "Generated $PLIST_PATH is not valid"
	printf 'Wrote %s\n\n' "$PLIST_PATH"
}

activate_agent() {
	/bin/launchctl bootout "gui/$UID/$LABEL" 2>/dev/null
	/bin/launchctl bootstrap "gui/$UID" "$PLIST_PATH" ||
		fail "Could not load the agent. Try running this again."
	printf 'Agent loaded. Mounting now, this takes 15-20 seconds per share ...\n'
	/bin/launchctl kickstart -p "gui/$UID/$LABEL" >/dev/null 2>&1
}

verify_mounts() {
	local waited=0 limit=$((25 * ${#SHARES[@]} + 20))
	while [ $waited -lt $limit ]; do
		if all_shares_mounted; then
			printf '\nDone. These are mounted and visible in Finder:\n'
			local share
			for share in "${SHARES[@]}"; do printf '  /Volumes/%s\n' "$share"; done
			printf '\nThey will remount by themselves at login, after sleep, and when\n'
			printf 'this Mac rejoins the home network. Nothing to maintain.\n\n'
			printf 'One last thing: if macOS shows a notification saying\n'
			printf '"mount-smb-shares can run in the background", leave it enabled.\n'
			printf 'It also appears in System Settings > General > Login Items.\n'
			return 0
		fi
		/bin/sleep 3
		waited=$((waited + 3))
		printf '.'
	done

	printf '\n\nThe agent is installed but the shares did not mount in time.\n'
	printf 'What it logged:\n'
	/usr/bin/log show --last 5m \
		--predicate 'eventMessage CONTAINS "mount-smb-shares:"' \
		--style compact 2>/dev/null | /usr/bin/tail -12
	printf '\nCurrently mounted:\n'
	/sbin/mount | /usr/bin/grep -i smbfs || printf '  (no SMB mounts)\n'
	return 1
}

# --- uninstall -------------------------------------------------------------

uninstall() {
	local account
	account=$(installed_account)

	/bin/launchctl bootout "gui/$UID/$LABEL" 2>/dev/null &&
		printf 'Unloaded the agent.\n'
	/bin/rm -f "$PLIST_PATH" && printf 'Removed %s\n' "$PLIST_PATH"
	/bin/rm -rf "$SUPPORT_DIR" && printf 'Removed %s\n' "$SUPPORT_DIR"

	if [ -n "$account" ]; then
		ACCOUNT="$account"
		forget_password "$HOST"
		forget_password "$ALT_HOST"
		printf 'Removed keychain entries for %s.\n' "$account"
	else
		printf 'Could not tell which NAS account was used, so the keychain entries\n'
		printf 'were left alone. Remove them in Keychain Access if you want them gone.\n'
	fi

	printf '\nUninstalled. Any currently mounted shares stay mounted until you\n'
	printf 'eject them or restart.\n'
}

# Recovers the account name from the generated script so uninstall can find the
# matching keychain entries.
installed_account() {
	[ -f "$SCRIPT_PATH" ] || return 0
	/usr/bin/awk -F= '$1 == "ACCOUNT" { gsub(/^['"'"'"]|['"'"'"]$/, "", $2); print $2; exit }' \
		"$SCRIPT_PATH"
}

# --- helpers ---------------------------------------------------------------

# ping is used purely as a resolver: it prints the address before waiting for a
# reply, so this works even if the NAS ignores ICMP. -t5 rather than -t1 because
# the deadline covers resolution, and a cold mDNS lookup needs the headroom.
resolve_host() {
	/sbin/ping -c1 -t5 "$HOST" 2>/dev/null |
		/usr/bin/awk -F'[()]' 'NR == 1 { print $2; exit }'
}

# -U updates an existing item instead of failing. The password is passed as an
# argument because that is the only way `security` accepts it; it is briefly
# visible to `ps` on this machine during setup and never touches disk.
store_password() {
	/usr/bin/security add-internet-password -U \
		-a "$ACCOUNT" -s "$1" -r "smb " -D "Network Password" \
		-w "$PASSWORD" >/dev/null 2>&1
}

forget_password() {
	/usr/bin/security delete-internet-password \
		-a "$ACCOUNT" -s "$1" -r "smb " >/dev/null 2>&1
}

all_shares_mounted() {
	local share
	for share in "${SHARES[@]}"; do
		/sbin/mount | /usr/bin/awk \
			-v a="//$ACCOUNT@$HOST/$share" -v b="//$ACCOUNT@$ALT_HOST/$share" \
			'$1 == a || $1 == b { found = 1 } END { exit !found }' || return 1
	done
	return 0
}

quoted_shares() {
	local out="" share
	for share in "${SHARES[@]}"; do
		out="$out $(printf '%q' "$share")"
	done
	printf '%s' "${out# }"
}

xml_escape() {
	printf '%s' "$1" | /usr/bin/sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

fail() {
	printf '\nERROR: %s\n' "$1" >&2
	exit 1
}

main "$@"
